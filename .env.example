# Required for live, shared reports. Without these the app shows no reports and
# reporting is disabled. Find both in Supabase: Project Settings → API Keys (or
# the green "Connect" button). The publishable (anon) key is safe to expose:
# row level security decides what it can do. VITE_SUPABASE_ANON_KEY also works.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional. Public site URL for link previews (defaults to the Vercel production domain).
VITE_SITE_URL=https://lotpulse.example
# Optional. Shown on /privacy for data deletion requests.
VITE_CONTACT_EMAIL=
