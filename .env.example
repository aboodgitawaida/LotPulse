# Optional. Without these, LotPulse runs in demo mode with simulated sightings.
# Find both in Supabase: Project Settings → API Keys (or the green "Connect" button).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional. Public site URL for link previews (defaults to the Vercel production domain).
VITE_SITE_URL=https://lotpulse.example
# Optional. Shown on /privacy for data deletion requests.
VITE_CONTACT_EMAIL=
